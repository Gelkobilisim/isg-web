rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is authenticated via Firebase Auth
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if user has admin claim
    function isAdmin() {
      return isAuthenticated() && request.auth.token.role == 'admin';
    }

    // User secrets: Strictly hidden from client-side read and write.
    // Accessible ONLY via server-side Firebase Admin SDK.
    match /user_secrets/{userId} {
      allow read, write: if false;
    }

    // Users: Readable by application users.
    // Write permitted for user profiles and tokens, but client cannot write/overwrite passwords directly.
    match /users/{userId} {
      allow read: if true;
      allow write: if !('password' in request.resource.data);
    }

    // Tasks (İSG İhlal ve Aksiyon Kayıtları): Full access for application management
    match /tasks/{taskId} {
      allow read, write: if true;
    }

    // Loadings (Sevkiyat ve Lojistik Kayıtları): Full access for loading operations
    match /loadings/{loadingId} {
      allow read, write: if true;
    }

    // System configurations and department points
    match /system/{docId} {
      allow read, write: if true;
    }

    // Point history logs
    match /point_logs/{logId} {
      allow read, write: if true;
    }

    // User notification inbox
    match /user_notifications/{notificationId} {
      allow read, write: if true;
    }

    // System notification logs: Read only from client, server Admin SDK handles writes
    match /notification_logs/{logId} {
      allow read: if true;
      allow write: if false;
    }

    // Feedbacks & Error Reports (accessible from ErrorBoundary and feedback modal)
    match /feedbacks/{feedbackId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if true;
    }

    // Catch-all fallback: Explicitly deny all other collections and arbitrary documents
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
